# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 真实数据样本与本地大文件 (严禁入库)
*.zip
!fixtures/*.zip
data-zip/
data-*/
samples/

# 运行与测试产物
dist/
out/
tmp/
coverage/
.nyc_output/
# E2E 产物（trace / 截图 / 实例日志 / pid）——含实例侧真实数据风险，严禁入库（L1-MR-14）
test-results/
# Playwright 持久化 profile（含 Cookies / Session Storage / 缓存，严禁入库 —— L1-MR-14）
# 通配以覆盖 .pw-profile/ 与 .pw-profile-dev/ 等分实例 profile
.pw-profile*/

# 环境配置与凭据安全
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Trellis 运行时本地数据
.trellis/.developer
.trellis/.current-task
.trellis/.runtime/
.history/

# 编辑器与操作系统私有文件
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 本地文档备份（非项目产物，勿入库）
CLAUDE.md.bak
*.md.bak

# 实例诊断原始采样（含实例侧真实目录名/用户数据风险 — L1-MR-14 红线）
